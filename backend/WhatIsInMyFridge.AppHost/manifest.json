{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "cosmos": {
      "type": "azure.bicep.v0",
      "connectionString": "{cosmos.outputs.connectionString}",
      "path": "cosmos.module.bicep"
    },
    "WhatIsInMyFridge": {
      "type": "value.v0",
      "connectionString": "{cosmos.outputs.connectionString};Database=WhatIsInMyFridge"
    },
    "storage": {
      "type": "azure.bicep.v0",
      "path": "storage.module.bicep"
    },
    "blobs": {
      "type": "value.v0",
      "connectionString": "{storage.outputs.connectionString}"
    },
    "frontend": {
      "type": "executable.v0",
      "workingDirectory": "../../frontend",
      "command": "bash",
      "args": [
        "start-dev.sh"
      ],
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 5174,
          "targetPort": 5173
        }
      }
    },
    "api": {
      "type": "project.v0",
      "path": "../WhatIsInMyFridge.Api/WhatIsInMyFridge.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{api.bindings.http.targetPort}",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ALLOWED_ORIGINS": "{frontend.bindings.http.url}",
        "ConnectionStrings__CosmosDb": "{WhatIsInMyFridge.connectionString}",
        "ConnectionStrings__BlobStorage": "{blobs.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 5000
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "cosmos-roles": {
      "type": "azure.bicep.v0",
      "path": "cosmos-roles.module.bicep",
      "params": {
        "cosmos_outputs_name": "{cosmos.outputs.name}",
        "principalId": ""
      }
    },
    "storage-roles": {
      "type": "azure.bicep.v0",
      "path": "storage-roles.module.bicep",
      "params": {
        "storage_outputs_name": "{storage.outputs.name}",
        "principalType": "",
        "principalId": ""
      }
    }
  }
}
