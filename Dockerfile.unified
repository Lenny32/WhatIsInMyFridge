# Multi-stage build: Frontend + Backend in one container
FROM denoland/deno:1.40.0 AS frontend-build

WORKDIR /frontend

# Copy frontend files
COPY frontend/deno.json frontend/deno.lock* ./
COPY frontend/package.json ./

# Install dependencies
RUN deno install

# Copy source code
COPY frontend/ ./

# Build frontend with configurable API base (will be set at runtime via nginx)
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}
RUN deno task build

# Backend build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS backend-build

WORKDIR /src

# Copy solution and project files
COPY global.json ./
COPY WhatIsInMyFridge.sln ./
COPY backend/WhatIsInMyFridge.Api/WhatIsInMyFridge.Api.csproj ./backend/WhatIsInMyFridge.Api/
COPY backend/WhatIsInMyFridge.ServiceDefaults/WhatIsInMyFridge.ServiceDefaults.csproj ./backend/WhatIsInMyFridge.ServiceDefaults/

# Restore dependencies
RUN dotnet restore backend/WhatIsInMyFridge.Api/WhatIsInMyFridge.Api.csproj

# Copy everything else and build
COPY backend/ ./backend/
RUN dotnet publish backend/WhatIsInMyFridge.Api/WhatIsInMyFridge.Api.csproj \
    -c Release \
    -o /app/backend \
    --no-restore

# Final runtime stage with nginx + .NET
FROM mcr.microsoft.com/dotnet/aspnet:9.0

# Install nginx and curl for health checks
RUN apt-get update && \
    apt-get install -y nginx curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend
COPY --from=backend-build /app/backend ./backend

# Copy frontend to nginx directory
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html

# Create nginx config that proxies /api to backend
RUN cat > /etc/nginx/sites-available/default <<'EOF'
server {
    listen 80;
    server_name _;

    # Frontend
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Proxy API requests to backend
    location /api {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://localhost:5000/health;
    }
}
EOF

# Create startup script
RUN cat > /app/start.sh <<'EOF'
#!/bin/bash
set -e

echo "Starting nginx..."
nginx

echo "Starting backend API..."
cd /app/backend
exec dotnet WhatIsInMyFridge.Api.dll
EOF

RUN chmod +x /app/start.sh

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 80

# Environment variables (with defaults)
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:5000 \
    CORS_ORIGINS=* \
    JWT_SECRET_KEY="" \
    COSMOS_CONNECTION_STRING="" \
    BLOB_STORAGE_CONNECTION_STRING=""

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

ENTRYPOINT ["/app/start.sh"]
